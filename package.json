{
  "name": "tripmate-web",
  "version": "0.1.0",
  "private": true,
  "description": "TripMate Web client: Next.js static export",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "build": "next build",
    "check:eol": "node scripts/check-line-endings.mjs",
    "generate:contracts": "node scripts/generate-contracts.mjs",
    "check:contracts": "node scripts/check-contracts.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.108.4",
    "next": "16.4.6",
    "next-intl": "4.16.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.1",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "jsdom": "31.0.1",
    "msw": "2.15.0",
    "orval": "8.49.0",
    "tripmate-contracts": "git+https://github.com/huynguyennang-agilityio/tripmate-contracts.git#contracts-v0.2.0",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
